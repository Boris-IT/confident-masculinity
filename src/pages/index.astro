---
import Base from '../layouts/Base.astro';
import { SITE } from '../config.js';

const mods = import.meta.glob('../data/articles/*.js', { eager: true });
const articles = Object.values(mods)
  .map((m) => m.default)
  .filter((a) => !a.draft)
  .sort((a, b) => (b.featured ? 1 : 0) - (a.featured ? 1 : 0) || new Date(b.date) - new Date(a.date));

const [lead, ...rest] = articles;
---
<Base title={`${SITE.name} — ${SITE.tagline}`} description="Practical writing on dating, mindset and presence. Small things that make a difference, without the nonsense.">
  {lead && (
    <a class="lead" href={`/${lead.slug}/`}>
      <p class="kicker">{lead.kicker}</p>
      <h1 class="lead__title">{lead.title}</h1>
      <p class="lead__dek">{lead.dek}</p>
      <p class="lead__meta">{lead.dateLabel} · {lead.readingTime}</p>
    </a>
  )}

  {rest.length > 0 && (
    <section class="idx">
      <p class="more__label">Latest</p>
      {rest.map((a) => (
        <a class="idx__item" href={`/${a.slug}/`}>
          <p class="kicker" style="margin:0">{a.kicker}</p>
          <h3>{a.title}</h3>
          <p class="idx__dek">{a.dek}</p>
          <p class="idx__meta">{a.dateLabel} · {a.readingTime}</p>
        </a>
      ))}
    </section>
  )}

  <section class="strap">
    <p>{SITE.name} is about the parts of this you can actually do something about — how you
    come across, how you carry yourself, and the small practical things that make a
    difference. No hacks, no scripts, no pretending to be someone else.{' '}
    <a href="/about/">About us</a></p>
  </section>
</Base>
